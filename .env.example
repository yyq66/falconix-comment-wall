# Local development may leave DATABASE_URL unset to use data/wall.db.
# Render must use a durable external PostgreSQL database, e.g. Neon.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
COOKIE_SECURE=0
SEED_DEMO=1
# Demo password is intentionally public. Use test data only.
DEMO_PASSWORD=Wall2027!

# Optional OpenAI-compatible chat completions provider. Set all three to enable.
# Keep the key on the backend / hosting environment only.
SENTIMENT_API_BASE_URL=
SENTIMENT_API_MODEL=
SENTIMENT_API_KEY=
# No API configuration or API failure: use the original Chinese classification rules.
